/*
========================================================================================
    Nextflow config file for running the auto assembly mode test
========================================================================================
    Defines input files and everything required to validate per-sample assembly type
    autodetection with short-only, long-only, and hybrid samples.

    Use as follows:
        nextflow run nf-core/bacass -profile test_auto,<docker/singularity>

----------------------------------------------------------------------------------------
*/

// Limit resources so that this can run on GitHub Actions
process {
    resourceLimits = [
        cpus: 4,
        memory: '15.GB',
        time: '1.h'
    ]
}

params {
    config_profile_name             = 'Test_auto_mode profile'
    config_profile_description      = 'Heterogeneous test dataset to validate per-sample auto assembly routing'

    // Input data
    input                           = params.pipelines_testdata_base_path + 'bacass/bacass_auto_heterogeneous.csv'

    // Auto assembly routing
    assembly_type                   = 'auto'

    // Exclude Dragonflye because the test long reads are too shallow for assembly
    assembler                       = 'megahit,unicycler,flye'
    unicycler_args                  = '--mode bold --kmers 51 --spades_options " --only-assembler"'

    // some extra args to speed tests up
    prokka_args                     = ' --fast'
    skip_pycoqc                     = true
    skip_kraken2                    = true
    skip_kmerfinder                 = true
    skip_busco                      = true
}
