/*
========================================================================================
    Nextflow config file for running minimal tests
========================================================================================
    Defines input files and everything required to run a fast and simple pipeline test.

    Use as follows:
        nextflow run nf-core/bacass -profile test_long_rasusa,<docker/singularity>

----------------------------------------------------------------------------------------
*/

// Limit resources so that this can run on GitHub Actions
process {
    resourceLimits = [
        cpus: 4,
        memory: '15.GB',
        time: '1.h'
    ]
}

params {
    config_profile_name        = 'Test_long_rasusa profile'
    config_profile_description = 'Minimal test dataset to check pipeline function with RASUSA'

    // Input data
    input = params.pipelines_testdata_base_path + 'bacass/bacass_long_miniasm.tsv'

    // activate rasusa
    rasusa = true
    rasusa_coverage = 100

    // some extra args to speed tests up
    prokka_args     = " --fast"
    assembly_type   = 'long'
    assembler       = 'unicycler'
    skip_polish     = true
    skip_kraken2    = true
    skip_kmerfinder = true
}
