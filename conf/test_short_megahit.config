/*
========================================================================================
    Nextflow config file for running minimal short-read test with MEGAHIT
========================================================================================
    Defines input files and everything required to run a fast and simple pipeline test.

    Use as follows:
        nextflow run nf-core/bacass -profile test_short_megahit,<docker/singularity>

----------------------------------------------------------------------------------------
*/

process {
    resourceLimits = [
        cpus: 4,
        memory: '15.GB',
        time: '1.h'
    ]
}

params {
    config_profile_name        = 'Test_short_megahit profile'
    config_profile_description = 'Minimal short-read dataset to validate MEGAHIT assembly'

    // Input data
    input = params.pipelines_testdata_base_path + 'bacass/bacass_short_reseq.tsv'

    // some extra args to speed tests up
    prokka_args     = " --fast"
    assembly_type   = 'short'
    assembler       = 'megahit'
    skip_pycoqc     = true
    skip_kraken2    = true
    skip_kmerfinder = true
}
